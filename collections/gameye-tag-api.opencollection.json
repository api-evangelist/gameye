{
  "opencollection": "1.0.0",
  "info": {
    "name": "Gameye Session Artifacts Tag API",
    "version": "1.2.1"
  },
  "items": [
    {
      "info": {
        "name": "Tag",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Check if tag exists in the Gameye fleet",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox-gameye.gameye.net/tag/:region/:image/:version",
            "params": [
              {
                "name": "region",
                "value": "",
                "type": "path",
                "description": "The name of the region"
              },
              {
                "name": "image",
                "value": "",
                "type": "path",
                "description": "The id of the image"
              },
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "The image version otherwise known as the Docker 'tag'."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Check if tag exists in the Gameye fleet"
        }
      ]
    }
  ],
  "bundled": true
}