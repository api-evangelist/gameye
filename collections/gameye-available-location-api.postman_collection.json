  "info": {
    "_postman_id": "94826dae-857b-447d-9338-7784e5342064",
    "name": "Gameye Session Artifacts Available Location API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Gameye Session API offers an agnostic way of hosting containerized game sessions without having to worry about geographic capacity or scalability issues.  The API offers a complete suite of features to host a server based multiplayer game.\n# Authentication\nAll endpoints of the Gameye Session API require authorization. This is done through Bearer Token Authentication. A bearer token is thus required in the  HTTP header of each request.\nFor example: ```Authorization: Bearer <token>```\n",
      "type": "text/plain"
    }
  }
